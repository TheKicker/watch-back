# Secrets — OHGO_API_KEY lives in a repo secret in CI and a local .env otherwise.
# It must never reach a commit: this site is public and so is its history.
.env
.env.*
!.env.example
*.key
*.pem

# Node — no package.json today, but scripts/fetch-cameras.mjs runs under Node
# and anything added later (a linter, a test runner) lands here.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Local scratch — hand runs of the fetch script, ad-hoc API dumps.
*.local
tmp/
.cache/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Claude Code — machine-local permissions, not shared config.
.claude/settings.local.json

# OS cruft
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
